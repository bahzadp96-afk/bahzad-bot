# پۆڕتی سێرڤەر (بۆ تاقیکردنەوەی ناوخۆیی یان سێرڤەری ئۆنلاین)
PORT=3000

# ----------------------------------------------------
# 1. بەشەکانی فەیسبووک و مێسنجەر (Facebook Meta Setup)
# ----------------------------------------------------
# کلیلی پەیوەندی پەیج (Page Access Token) کە لە پەڕەی Meta Developers وەریدەگریت:
PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN_HERE

# تۆکنی تایبەت بە پشکنینی وێبهوک (دەتوانیت هەر وشەیەک بنووسیت و لە Meta هەمان وشە دابنێیتەوە):
VERIFY_TOKEN=my_secret_mobile_bot_verify_token_2025

# ----------------------------------------------------
# 2. کلیلی زیرەکی دەستکرد (AI Model Settings)
# ----------------------------------------------------
# کلیلی گووگڵ جێمینای لە https://aistudio.google.com بە بێبەرامبەر وەردەگیرێت:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ئەگەر ویستت OpenAI بەکاربهێنیت:
OPENAI_API_KEY=
AI_PROVIDER=gemini

# ----------------------------------------------------
# 3. زانیارییەکانی دوکانی مۆبایلەکەت
# ----------------------------------------------------
SHOP_NAME=دوکانی مۆبایلی پێشکەوتوو
SHOP_ADDRESS=سلێمانی، شەقامی مەولەوی / یان هەولێر
SHOP_PHONE=07501234567 / 07701234567
SHOP_HOURS=هەموو ڕۆژێک لە ٩:٠٠ی بەیانی تا ١٠:٠٠ی شەو
